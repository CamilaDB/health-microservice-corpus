describe('validateEncounterFields', () => {
  const createDto = {
    adtType: AdtType.A01,
    ward: undefined,
    patientId: 'testPatientId'
  };

  it('should throw an error if ward is required for A01 and not provided', () => {
    (service as any).validateEncounterFields = jest.fn();
    expect(() => service.validateEncounterFields(createDto)).toThrow(new BadRequestException('Ward is required for ADT A01 (admission)'));
  });

  const createDto2 = {
    adtType: AdtType.A02,
    ward: undefined,
    patientId: 'testPatientId'
  };

  it('should throw an error if ward is required for A02 and not provided', () => {
    (service as any).validateEncounterFields = jest.fn();
    expect(() => service.validateEncounterFields(createDto2)).toThrow(new BadRequestException('Ward is required for ADT A02 (transfer)'));
  });

  const createDto3 = {
    adtType: AdtType.A03,
    ward: 'testWard',
    patientId: 'testPatientId'
  };

  it('should throw an error if ward must not be informed for A03 and provided', () => {
    (service as any).validateEncounterFields = jest.fn();
    expect(() => service.validateEncounterFields(createDto3)).toThrow(new BadRequestException('Ward must not be informed for ADT A03 (discharge)'));
  });

  const createDto4 = {
    adtType: AdtType.A08,
    ward: 'testWard',
    patientId: 'testPatientId'
  };

  it('should throw an error if ward must not be informed for A08 and provided', () => {
    (service as any).validateEncounterFields = jest.fn();
    expect(() => service.validateEncounterFields(createDto4)).toThrow(new BadRequestException('Ward must not be informed for ADT A08 (update)'));
  });

  const createDto5 = {
    adtType: AdtType.A08,
    ward: undefined,
    patientId: undefined
  };

  it('should throw an error if patientId is required for A08 and not provided when ward is also undefined', () => {
    (service as any).validateEncounterFields = jest.fn();
    expect(() => service.validateEncounterFields(createDto5)).toThrow(new BadRequestException('PatientId is required for ADT A08 (update)'));
  });
});
