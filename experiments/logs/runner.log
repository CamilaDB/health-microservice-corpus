    orderRepositoryMock.findById.mockResolvedValue(createMock<Order>({ encounterId: 'encounter-id' }));

    await expect(service.validateOrderResult('order-1', ResultStatus.FINAL)).rejects.toThrow(BadRequestException);
  });

