<SOURCE_FUNCTION>
async createOrder(dto: CreateOrderDto): Promise<Order> {
    const encounter = await this.encounterService.getEncounterById(
      dto.encounterId,
    );
    if (encounter.status === EncounterStatus.DISCHARGED) {
      throw new BadRequestException(
        'Cannot create order for a discharged encounter',
      );
    }
    if (new Date(dto.requestedAt) < new Date(encounter.admitDate)) {
      throw new BadRequestException(
        'Order date cannot be before admission date',
      );
    }
    const existing = await this.orderRepository.existsPendingOrder(
      dto.encounterId,
      dto.examType,
    );
    if (existing) {
      throw new ConflictException(
        'A pending order for this exam already exists',
      );
    }
    const order = this.orderRepository.create({
      ...dto,
      requestedAt: new Date(dto.requestedAt),
      status: OrderStatus.PENDING,
      notes: dto.notes ?? null,
    });
    return this.orderRepository.save(order);
  }
</SOURCE_FUNCTION>

<CONTEXT>
Order:
- id: string
- encounterId: string
- examType: ExamType
- status: OrderStatus
- requestedAt: Date
- requestedBy: string
- notes: string | null
- created_at: Date
- updated_at: Date
- encounter: Encounter
- results: Result[]

CreateOrderDto:
- encounterId: string
- examType: ExamType
- requestedAt: string
- requestedBy: string
- notes?: string | undefined

enum ExamType: ExamType.HEMOGRAM | ExamType.GLUCOSE | ExamType.CREATININE | ExamType.TSH | ExamType.URINE
enum OrderStatus: OrderStatus.PENDING | OrderStatus.IN_PROGRESS | OrderStatus.COMPLETED | OrderStatus.CANCELLED
enum EncounterStatus: EncounterStatus.ADMITTED | EncounterStatus.TRANSFERRED | EncounterStatus.DISCHARGED
</CONTEXT>


