    expect(await service.listEncountersByPatient('patient-123', { status: EncounterStatus.ADMITTED })).toEqual([mockAdmittedEncounter]);
  });

  it('should order encounters by admitDate when orderBy is provided in dto', async () => {
    const mockFirst = new Encounter({ id: 'enc-first', patientId: 'patient-123' }) as any;
    const mockSecond = new Encounter({ id: 'enc-second', patientId: 'patient-123'}) as any;

    encounterRepositoryMock.findByPatient.mockResolvedValue([mockFirst, mockSecond]);
    patientServiceMock.getPatientById.mockResolvedValue(new Patient());

    expect(await service.listEncountersByPatient('patient-123', { orderBy: 'admitDate' })).toEqual(expect.arrayContaining([mockFirst, mockSecond]));
  });

  it('should order encounters by created_at when provided in dto', async () => {
    const mockFirst = new Encounter({ id: 'enc-first', patientId: 'patient-123'}) as any;
    const mockSecond = new Encounter({ id: 'enc-second', patientId: 'patient-123' }) as any;

    encounterRepositoryMock.findByPatient.mockResolvedValue([mockFirst, mockSecond]);
    patientServiceMock.getPatientById.mockResolvedValue(new Patient());

    expect(await service.listEncountersByPatient('patient-123', { orderBy: 'created_at' })).toEqual(expect.arrayContaining([mockFirst, mockSecond]));
  });

  it('should order encounters by admitDate in DESC when provided in dto', async () => {
    const mockFirst = new Encounter({ id: 'enc-first', patientId: 'patient-123'}) as any;
    const mockSecond = new Encounter({ id: 'enc-second', patientId: 'patient-123' }) as any;

    encounterRepositoryMock.findByPatient.mockResolvedValue([mockFirst, mockSecond]);
    patientServiceMock.getPatientById.mockResolvedValue(new Patient());

    expect(await service.listEncountersByPatient('patient-123', { orderBy: 'admitDate', order: 'DESC' })).toEqual(expect.arrayContaining([mockFirst, mockSecond]));
  });

  it('should throw NotFoundException when patientService throws error with different message type', async () => {
    const mockError = new Error();

    encounterRepositoryMock.findByPatient.mockResolvedValue([]);
    patientServiceMock.getPatientById.mockRejectedValue(mockError as any);

    await expect(service.listEncountersByPatient('patient-123', {})).rejects.toThrow(Error);
  });
});
