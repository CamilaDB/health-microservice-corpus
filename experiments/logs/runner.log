describe('createEncounter', () => {
  it('should throw a BadRequestException when trying to admit an inactive patient', async () => {
    const dto = new CreateEncounterDto();
    dto.patientId = 'inactive-patient-id';
    encounterRepositoryMock.findActiveByPatient.mockResolvedValueOnce({ id: 'active-encounter-id' });
    await expect(service.createEncounter(dto)).rejects.toThrow(BadRequestException);
  });

  it('should throw a ConflictException when trying to admit a patient with an active encounter', async () => {
    const dto = new CreateEncounterDto();
    dto.patientId = 'patient-id';
    encounterRepositoryMock.findActiveByPatient.mockResolvedValueOnce({ id: 'active-encounter-id' });
    await expect(service.createEncounter(dto)).rejects.toThrow(ConflictException);
  });

  it('should create a new encounter when patient is active and has no active encounters', async () => {
    const dto = new CreateEncounterDto();
    dto.patientId = 'patient-id';
    encounterRepositoryMock.findActiveByPatient.mockResolvedValueOnce(null);
    const createdEncounter = await service.createEncounter(dto);
    expect(encounterRepositoryMock.save).toHaveBeenCalledTimes(1);
    expect(createdEncounter.id).toBeDefined();
  });
});


