- unit?: string | undefined
- referenceMin?: number | undefined
- referenceMax?: number | undefined
- notes?: string | undefined

enum ResultStatus: ResultStatus.PRELIMINARY | ResultStatus.FINAL | ResultStatus.CORRECTED
</CONTEXT>


